PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# --- Google Earth Engine (historical trend, /trend) ---
# Mode: 'real' (default) uses the live GEE API; 'mock'/'dev' uses a clearly
# labelled deterministic fixture (NOT real satellite data, for development/tests).
GEE_MODE=

# Service-account credentials (never commit real values — placeholder only).
# Path must point to the private JSON service-account key file provided by Google.
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GEE_SERVICE_ACCOUNT_KEY_PATH=
