PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# --- HTTP hardening ---
# Allowlist of origins allowed to call the ML API (comma-separated). A wildcard
# is never allowed. Defaults to local frontend dev origins when left empty.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional host allowlist for the Host header (comma-separated). Leave empty to
# accept any Host; set it in production to prevent host-header injection.
# ALLOWED_HOSTS=api.example.com

# Opt-in in-memory rate limiting (off by default). When enabled, each client IP
# is limited to ML_RATE_LIMIT_MAX requests per ML_RATE_LIMIT_WINDOW seconds.
ML_RATE_LIMIT_ENABLED=false
ML_RATE_LIMIT_MAX=60
ML_RATE_LIMIT_WINDOW=60

# --- Vision-Language Models (VQA and Captioning) ---
# Base model for both VQA and captioning endpoints
VLM_MODEL=Qwen/Qwen2-VL-2B-Instruct

# Optional per-tool model IDs. Default: fall back to VLM_MODEL when unset.
# VQA_MODEL=
# CAPTION_MODEL=

# LoRA adapter path for the fine-tuned Qwen2-VL model (VQA endpoint).
# Relative paths resolve against the ml-service working directory when running
# uvicorn from ml-service/. In Docker the container path is
# /app/adaptation/final_adapter (see docker-compose.yml).
VQA_ADAPTER_PATH=./adaptation/final_adapter
# Optional LoRA adapter path for captioning; defaults to the base model when unset.
# CAPTION_ADAPTER_PATH=./adaptation/final_adapter

# --- Google Earth Engine (historical trend, /trend) ---
# Mode: 'real' (default) uses the live GEE API; 'mock'/'dev' uses a clearly
# labelled deterministic fixture (NOT real satellite data, for development/tests).
GEE_MODE=

# Service-account credentials (never commit real values — placeholder only).
# Path must point to the private JSON service-account key file provided by Google.
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GEE_SERVICE_ACCOUNT_KEY_PATH=

# --- SpatioTemporal Asset Catalog (STAC: scene search + AOI acquisition,
# --- /stac/search and /stac/ingest) ---
# Base URL of the STAC API. Publicly reachable catalogs need no credentials:
#   Earth Search        https://earth-search.aws.element84.com/v1
#   Planetary Computer  https://planetarycomputer.microsoft.com/api/stac/v1
STAC_API_URL=https://earth-search.aws.element84.com/v1

# Provider mode:
#   'real'    (default) use the live STAC API configured above; fails clearly
#             if unreachable. Never fabricates scenes.
#   'offline' explicitly unconfigured; every operation fails with a clear
#             error rather than inventing data.
#   'test'/'mock'/'dev' clearly-labelled deterministic fixtures (NOT real
#             satellite data; only for development/tests).
STAC_MODE=

# Optional provider name reported in metadata (informational).
STAC_PROVIDER=

# Optional credentials for a private/proxied catalog (never commit real values).
STAC_CLIENT_ID=
STAC_CLIENT_SECRET=

# Directory where acquired analysis rasters + previews are written
# (default: ./acquisitions under the ml-service working directory).
ACQUISITION_DIR=
