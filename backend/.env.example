PORT=5000
MONGODB_URI=mongodb://localhost:27017/satquery
JWT_SECRET=your_jwt_secret_here
ML_SERVICE_BASE_URL=http://localhost:8000
# Per-call timeout to the ML service in ms (defaults to 120000). Keep high for
# real VLM inference on CPU (Qwen2-VL + LoRA can take ~2 minutes).
ML_SERVICE_TIMEOUT_MS=120000
LLM_API_KEY=your_llm_api_key
LLM_PROVIDER=openai
NODE_ENV=development

# Demo-region trend precompute fallback (BACKEND.md §15.5)
# The exact demo region is a REQUIRED configuration input — it is not defined
# anywhere in the repository and must NOT be invented. Populate these to enable
# the offline/live-demo trend fallback, then run `npm run precompute:demo-trend`.
# DEMO_TREND_REGION={"type":"Polygon","coordinates":[[[...]]]}
# DEMO_TREND_START_DATE=YYYY-MM-DD
# DEMO_TREND_END_DATE=YYYY-MM-DD
# DEMO_TREND_METRIC=ndvi
# DEMO_TREND_INTERVAL=monthly
# DEMO_TREND_TTL_DAYS=365
