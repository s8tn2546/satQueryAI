PORT=5000
MONGODB_URI=mongodb://localhost:27017/satquery
JWT_SECRET=your_jwt_secret_here
ML_SERVICE_BASE_URL=http://localhost:8000
# Per-call timeout to the ML service in ms (defaults to 600000). Keep high for
# real VLM inference on CPU (Qwen2-VL + LoRA measured ~200s cold, ~117s warm).
# A timeout produces a clearly-labeled mock result, never a hard error.
ML_SERVICE_TIMEOUT_MS=600000
LLM_API_KEY=your_llm_api_key
LLM_PROVIDER=openai
NODE_ENV=development

# --- HTTP hardening ---
# JWT_SECRET is REQUIRED in production: startup aborts if it is unset. In
# development only (@ NODE_ENV != production) a long-lived dev-only fallback is
# used so the API still boots locally. Never reuse the dev secret in production.
# CORS_ORIGINS: comma-separated allowed browser origins (default: local frontend
# dev origins). A wildcard is treated as no override.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# TRUST_PROXY: number of trusted proxy hops for correct client IPs behind a
# reverse proxy (1 for a single nginx/caddy in front). Leave unset when exposed
# directly.
# TRUST_PROXY=1

# Optional rate-limit tuning. The defaults below match the code; override per
# deployment need. All limits skip /health.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300        # global /api cap
# AUTH_RATE_LIMIT_MAX=30    # /api/auth/*
# QUERY_RATE_LIMIT_MAX=60   # /api/query/*
# UPLOAD_RATE_LIMIT_MAX=30  # /api/images/upload

# Demo-region trend precompute fallback (BACKEND.md §15.5)
# The exact demo region is a REQUIRED configuration input — it is not defined
# anywhere in the repository and must NOT be invented. Populate these to enable
# the offline/live-demo trend fallback, then run `npm run precompute:demo-trend`.
# DEMO_TREND_REGION={"type":"Polygon","coordinates":[[[...]]]}
# DEMO_TREND_START_DATE=YYYY-MM-DD
# DEMO_TREND_END_DATE=YYYY-MM-DD
# DEMO_TREND_METRIC=ndvi
# DEMO_TREND_INTERVAL=monthly
# DEMO_TREND_TTL_DAYS=365

# --- STAC acquisition (/api/stac/search, /api/stac/ingest) ---
# The backend proxies STAC requests to the ML service (`/stac/search` and
# `/stac/ingest`); the STAC endpoint itself is configured on the ML side via
# its STAC_API_URL / STAC_MODE (see ml-service/.env.example). Offline fallbacks
# for these endpoints are clearly-labelled non-results, never fabricated scenes.
